# Supabase Configuration
# Replace these with your actual Supabase project credentials from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Mode
# Set to 'true' or leave blank when testing without live Supabase credentials.
# When enabled, the app seamlessly falls back to realistic mock database data
# so you can immediately explore and test all pages, search, filters, and flows!
NEXT_PUBLIC_DEMO_MODE=true
